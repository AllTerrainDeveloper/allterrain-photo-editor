<?xml version="1.0"?>
<ruleset name="AllTerrain Photo Editor">
	<description>WordPress Coding Standards for the AllTerrain Photo Editor plugin.</description>

	<file>.</file>

	<exclude-pattern>/node_modules/*</exclude-pattern>
	<exclude-pattern>/vendor/*</exclude-pattern>
	<exclude-pattern>/assets/*</exclude-pattern>
	<exclude-pattern>/tests/vitest/*</exclude-pattern>

	<arg name="extensions" value="php"/>
	<arg name="colors"/>
	<arg value="sp"/>

	<rule ref="WordPress">
		<!-- The bundled PixiJS is vendored, not enqueued as a dependency. -->
		<exclude name="WordPress.WP.EnqueuedResources"/>
	</rule>

	<!-- OpenStation's App Framework finds an app by the `.os.php` suffix; the dot is the contract. -->
	<rule ref="WordPress.Files.FileName.NotHyphenatedLowercase">
		<exclude-pattern>*/apps/*/*.os.php</exclude-pattern>
	</rule>

	<config name="testVersion" value="7.4-"/>
	<rule ref="PHPCompatibilityWP"/>

	<config name="minimum_wp_version" value="6.0"/>

	<rule ref="WordPress.WP.I18n">
		<properties>
			<property name="text_domain" type="array">
				<element value="allterrain-photo-editor"/>
			</property>
		</properties>
	</rule>

	<rule ref="WordPress.NamingConventions.PrefixAllGlobals">
		<properties>
			<property name="prefixes" type="array">
				<element value="lienzo"/>
				<element value="LIENZO"/>
			</property>
		</properties>
	</rule>
</ruleset>
